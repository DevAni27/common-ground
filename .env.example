# Copy to .env only if you need to change defaults. Never commit a real .env.
# The server reads these from the environment (see README for Windows commands).

APP_PORT=8787
# 127.0.0.1 = this laptop only. 0.0.0.0 = phones on the same Wi-Fi can connect.
APP_BIND_HOST=127.0.0.1
# Set when serving behind a different public origin; otherwise the Host header is used for origin checks.
PUBLIC_APP_ORIGIN=

# Real-world data (free, no keys). Identify the app to the free OSM services:
APP_CONTACT=your-email-or-repo-url
# Public-transport timetables via Transitous (opt-in: their policy asks you to message the
# maintainers first — https://transitous.org/api/). When off, people type their usual bus/metro time.
TRANSITOUS_ENABLED=false
# Optional overrides (defaults are the public OSM services)
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter  (comma-separated; tried in order when one is busy)
# FOOT_ROUTING_URL=https://routing.openstreetmap.de/routed-foot
# CAR_ROUTING_URL=https://routing.openstreetmap.de/routed-car

# file (default, ./.local-data) | memory (not persistent) | mongodb (needs MONGODB_URI)
STORE_ADAPTER=file
LOCAL_STORE_DIR=.local-data
MONGODB_URI=
MONGODB_DB=common_ground
RETENTION_DAYS_AFTER_OUTING=7

# Local Gemma via Ollama. Keep Ollama bound to loopback; the browser never talks to it.
AI_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Optional integrations (not required for local use)
SENTRY_DSN=
SERPAPI_API_KEY=
